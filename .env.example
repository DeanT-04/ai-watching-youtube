# Copy to .env and adjust. Every variable is optional — config.py has sensible defaults.
# Prefix is YTEXTRACT_; values are parsed as the types declared in config.py.

# Worker / CPU safety (Section 6 of the build prompt)
YTEXTRACT_MAX_WORKERS=7
YTEXTRACT_CPU_THRESHOLD_PERCENT=85.0
YTEXTRACT_CPU_POLL_INTERVAL=0.5
YTEXTRACT_CPU_SLEEP_SECONDS=2.0

# Keyframe selection (Phase 4)
YTEXTRACT_SAMPLE_RATE_FPS=0.5
YTEXTRACT_SIMILARITY_THRESHOLD=0.98

# Crop & preprocessing (Phase 5) — x,y,width,height; empty = no crop
YTEXTRACT_CROP=
YTEXTRACT_UPSCALE_SCALE=2

# Transcription (Phase 3) — CPU-only, int8
YTEXTRACT_WHISPER_MODEL_SIZE=tiny
YTEXTRACT_WHISPER_DEVICE=cpu
YTEXTRACT_WHISPER_COMPUTE_TYPE=int8
YTEXTRACT_WHISPER_LANGUAGE=

# OCR (Phase 6)
YTEXTRACT_OCR_CONFIDENCE_THRESHOLD=0.5

# External tool timeouts (seconds)
YTEXTRACT_YTDLP_TIMEOUT=3600
YTEXTRACT_FFMPEG_TIMEOUT=600

# Logging
YTEXTRACT_LOG_LEVEL=INFO
